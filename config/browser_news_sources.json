      "finance.yahoo.com"
    ],
    "article_url_patterns": [
      "^https://finance\\.yahoo\\.com/(markets|technology|news|economy|sectors)/([a-z-]+/)?articles?/[^/?#]+-\\d+\\.html"
    ],
    "max_pages": 3,
    "max_articles": 30,
    "use_page_publisher": true
  },
  {
    "source": "CNBC",
    "start_url": "https://www.cnbc.com/markets/",
